# Salin ke .env.local lalu isi. Semua boleh kosong.
#
# PENTING: semua variabel VITE_* DITANAM ke file hasil build saat `npm run build`.
# Mengubahnya (di .env.local atau di Vercel > Settings > Environment Variables)
# baru berlaku setelah build ulang / redeploy. Jangan taruh rahasia di sini:
# nilainya terbaca siapa pun di file JavaScript/HTML publik.

# Alamat publik situs, TANPA slash di akhir. Contoh:
#   https://inapr.org              (domain final)
#   https://nama-proyek.vercel.app (URL Vercel selama draf)
# Dipakai untuk URL kanonik, og:url, og:image absolut, JSON-LD url, dan sitemap.xml.
# Kosong = tag kanonik/og:url dan sitemap.xml tidak dibuat, og:image relatif.
VITE_SITE_URL=

# Alamat dasar folder slide PDF webinar, mis. https://inapr.org/slides/ atau /slides/.
# Kosong = tombol "Slide" tidak ditampilkan. Biarkan kosong sampai hosting PDF diputuskan.
VITE_SLIDES_BASE_URL=

# Base path bila situs dihosting di subfolder, mis. /inapr/. Kosong = "/" (root domain).
# JANGAN diisi di Vercel: Vercel menyajikan situs di root domain.
VITE_BASE=
