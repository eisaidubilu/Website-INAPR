# Salin ke .env.local lalu isi. Semua boleh kosong.
#
# PENTING: semua variabel VITE_* DITANAM ke file hasil build saat `npm run build`.
# Mengubahnya (di .env.local atau di Vercel > Settings > Environment Variables)
# baru berlaku setelah build ulang / redeploy. Jangan taruh rahasia di sini:
# nilainya terbaca siapa pun di file JavaScript/HTML publik.

# Alamat publik situs, TANPA slash di akhir. Contoh:
#   https://inapr.org              (domain final)
#   https://nama-proyek.vercel.app (URL Vercel selama draf)
# Dipakai untuk URL kanonik, og:url, og:image absolut, JSON-LD url, dan sitemap.xml.
# Disematkan di subfolder: isi dengan PATH PENUH, mis. https://inapr.org/landing/ (bersama VITE_BASE=/landing/).
# Bila hanya domain, seo-plugin menggabungkan base build; path eksplisit tetap lebih aman.
# Kosong = tag kanonik/og:url dan sitemap.xml tidak dibuat, og:image relatif.
VITE_SITE_URL=

# Alamat dasar folder slide PDF webinar, mis. https://inapr.org/slides/ atau /slides/.
# Kosong = tombol "Slide" tidak ditampilkan. Biarkan kosong sampai hosting PDF diputuskan.
VITE_SLIDES_BASE_URL=

# Base path bila situs dihosting di subfolder, mis. /inapr/. Kosong = "/" (root domain).
# JANGAN diisi di Vercel: Vercel menyajikan situs di root domain.
VITE_BASE=

# ---------------------------------------------------------------------------
# Sumber data anggota & arsip webinar (lihat docs/KONTRAK-DATA.md).
# Prioritas: VITE_API_BASE  >  same-origin (build produksi, VITE_API_BASE kosong)  >  Supabase  >  data lokal (src/data).
# Same-origin: build produksi tanpa VITE_API_BASE otomatis memanggil /api/public/* (path absolut, bukan di bawah
# base "/landing/"). Cocok untuk landing yang di-embed ke app Next (npm run build:embed).
# Semua kosong = data lokal. Bila sumber jauh gagal/kosong/lambat (>4 dtk), situs memakai data lokal.
# Hanya anon key. JANGAN PERNAH mengisi service-role key di sini: nilai VITE_* terbaca publik.
# ---------------------------------------------------------------------------

# Mode (a): alamat backend INAPR, mis. https://api.inapr.org (tanpa slash akhir).
# Memanggil {VITE_API_BASE}/api/public/members dan /api/public/archives.
# Isi "/" bila backend satu origin dengan situs atau diakses lewat proxy dev.
VITE_API_BASE=

# Mode (b): Supabase REST langsung, dipakai bila VITE_API_BASE kosong. Kedua variabel harus terisi.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hanya dev server: target proxy untuk /api. Bila terisi, dev server mem-proxy /api ke sini DAN memakai mode
# same-origin (walau VITE_API_BASE kosong). Dengan VITE_API_BASE terisi dan ini kosong, targetnya http://localhost:3000.
# Contoh: VITE_API_PROXY=http://localhost:3000 (app Next lokal). Tidak berpengaruh pada build.
VITE_API_PROXY=
